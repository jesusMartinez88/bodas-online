{
  "name": "tu-boda-online",
  "version": "2.1.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration production",
    "dev": "ng serve --configuration development",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href /tu-boda-online/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:security": "vitest run src/app/services/auth-security.spec.ts src/app/services/security-headers.spec.ts",
    "version:sync": "node scripts/update-version.js",
    "version:patch": "npm version patch && npm run version:sync",
    "version:minor": "npm version minor && npm run version:sync",
    "version:major": "npm version major && npm run version:sync",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "updatePnpm": "pnpm self-update",
    "createIndex": "node scripts/create-invitation.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@stripe/stripe-js": "^10.1.0",
    "aos": "^2.3.4",
    "canvas-confetti": "^1.9.4",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "prettier": "^3.9.10",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@ngx-env/builder": "^22.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/aos": "^3.0.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.5"
  }
}
